install_only=false

case "$#:$1" in
    0:)
        ;;
    1:--install|1:--instal)
        install_only=true
        ;;
    *)
        echo "Usage: $0 [--install]" >&2
        exit 1
        ;;
esac

venv_pip=/opt/rpp-venv/bin/pip

if [ ! -x "$venv_pip" ]; then
    echo "Virtual environment not found at /opt/rpp-venv; rebuild the dev container." >&2
    exit 1
fi

if [ "$install_only" = false ]; then
    sudo apt-get install -y \
        capnproto=1.1.0-2.1 \
        libcapnp-dev=1.1.0-2.1 \
        python3-pyqt6 \
        pybind11-dev \
        nlohmann-json3-dev \
        gdb

    git submodule update --init --recursive
fi

checkout_main() {
    if [ "$install_only" = false ]; then
        git checkout main
    fi
}

cd src

cd rpp_cli
checkout_main
"$venv_pip" install -e .
cd ..

cd rpp_common
checkout_main
"$venv_pip" install -e .
cd ..

cd rpp_orchestrator
checkout_main
"$venv_pip" install -e .
cd ..

cd rpp_plugin_registrator
checkout_main
"$venv_pip" install -e .
cd ..

cd rpp_py
checkout_main
"$venv_pip" install -e .
cd ..

cd rpp_testing
checkout_main
"$venv_pip" install -e .
cd ..